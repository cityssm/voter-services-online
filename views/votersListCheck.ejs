<%- include('_votersListHeader.ejs') -%>

<div class="tabs is-centered is-boxed">
  <ul>
    <li class="is-active">
      <a href="#tab--check" aria-controls="tab--check">
        <span class="icon is-small"><i class="fa-solid fa-magnifying-glass"></i></span>
        <span>Look Up Record</span>
      </a>
    </li>
    <li>
      <a href="#tab--status" aria-controls="tab--status">
        <span class="icon is-small"><i class="fa-solid fa-pen-to-square"></i></span>
        <span>Check Application Status</span>
      </a>
    </li>
  </ul>
</div>

<div class="tabs-content">
  <form
    class="tab-content"
    id="tab--check"
    action="<%= urlPrefix %>/votersList/result"
    method="POST"
  >
    <div class="message is-info">
      <div class="message-body">
        <p class="mb-2">
          Please enter your personal information below to look up your record in the voter's list.
          If your record is found, you will have the option to submit an application
          to update your information, or apply for voting by mail.
        </p>
        <p>
          If you are not found in the voter's list, you will be given the option
          to submit an application to be added to the list.
        </p>
      </div>
    </div>
    <div class="columns">
      <div class="column">
        <div class="field">
          <label class="label" for="votersList--firstName">
            First Name
          </label>
          <div class="control has-icons-right">
            <input
              class="input"
              id="votersList--firstName"
              name="firstName"
              type="text"
              maxlength="40"
              autofocus
              required
            />
            <span class="icon is-small is-right">
              <i class="fa-solid fa-asterisk"></i>
            </span>
          </div>
          <p class="help">
            Enter your legal first name as it appears on your identification documents.
            Avoid using nicknames or abbreviations.
          </p>
        </div>
      </div>
      <div class="column">
        <div class="field">
          <label class="label" for="votersList--lastName">
            Last Name
          </label>
          <div class="control has-icons-right">
            <input
              class="input"
              id="votersList--lastName"
              name="lastName"
              type="text"
              maxlength="40"
              required
            />
            <span class="icon is-small is-right">
              <i class="fa-solid fa-asterisk"></i>
            </span>
          </div>
        </div>
      </div>
    </div>

    <fieldset class="mb-4">
      <legend class="label">Date of Birth</legend>

      <div class="field has-addons">
        <div class="control is-expanded">
          <input
            class="input"
            id="votersList--dateOfBirthYear"
            name="dateOfBirthYear"
            type="number"
            min="<%= new Date().getFullYear() - 120 %>"
            max="<%= new Date().getFullYear() %>"
            aria-label="Date of Birth Year"
            placeholder="Year"
            required
          />
        </div>
        <div class="control">
          <span class="button is-static">-</span>
        </div>
        <div class="control is-expanded">
          <div class="select is-fullwidth">
            <select
              id="votersList--dateOfBirthMonth"
              name="dateOfBirthMonth"
              aria-label="Date of Birth Month"
              required
            >
              <option value="">(Select a Month)</option>
              <option value="01">January</option>
              <option value="02">February</option>
              <option value="03">March</option>
              <option value="04">April</option>
              <option value="05">May</option>
              <option value="06">June</option>
              <option value="07">July</option>
              <option value="08">August</option>
              <option value="09">September</option>
              <option value="10">October</option>
              <option value="11">November</option>
              <option value="12">December</option>
            </select>
          </div>
        </div>
        <div class="control">
          <span class="button is-static">-</span>
        </div>
        <div class="control is-expanded has-icons-right">
          <input
            class="input"
            id="votersList--dateOfBirthDay"
            name="dateOfBirthDay"
            type="number"
            min="1"
            max="31"
            aria-label="Date of Birth Day"
            placeholder="Day"
            required
          />
          <span class="icon is-small is-right">
            <i class="fa-solid fa-asterisk"></i>
          </span>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend class="title is-5">Residential Address</legend>

      <% if (configFunctions.getConfigProperty('settings.city') !== '') { %>
      <div class="message is-info">
        <div class="message-body">
          Note that only addresses in
          <span class="has-text-weight-semibold"><%= configFunctions.getConfigProperty('settings.city') %></span>
          are eligible for this service.
        </div>
      </div>
      <% } %>

      <div class="columns">
        <div class="column is-3">
          <div class="field">
            <label class="label" for="votersList--streetNumber">
              Street Number
            </label>
            <div class="control has-icons-right">
              <input
                class="input"
                id="votersList--streetNumber"
                name="streetNumber"
                type="text"
                maxlength="5"
                pattern="^[0-9]+.+"
                required
              />
              <span class="icon is-small is-right">
                <i class="fa-solid fa-asterisk"></i>
              </span>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="field">
            <label class="label" for="votersList--streetName">
              Street Name
            </label>
            <div class="control is-expanded has-icons-right">
              <div class="select is-fullwidth">
                <select
                  id="votersList--streetName"
                  name="streetName"
                  aria-label="Street Name"
                  required
                >
                  <option value="">(Loading street names...)</option>
                </select>
              </div>
              <span class="icon is-small is-right">
                <i class="fa-solid fa-asterisk"></i>
              </span>
            </div>
          </div>
        </div>
        <div class="column">
          <div class="field">
            <label class="label" for="votersList--unitNumber">
              Unit
            </label>
            <div class="control">
              <input
                class="input"
                id="votersList--unitNumber"
                name="unitNumber"
                type="text"
                maxlength="10"
              />
            </div>
          </div>
        </div>
      </div>
    </fieldset>

    <p class="has-text-centered mt-5">
      <button class="button is-medium is-success" id="votersList--submit" type="submit">
        <span class="icon">
          <i class="fa-solid fa-check-to-slot"></i>
        </span>
        <span>Lookup Voter's List Record</span>
      </button>
    </p>
  </form>

  <form
    class="tab-content is-hidden"
    id="tab--status"
    action="<%= urlPrefix %>/votersList/status"
    method="POST"
  >
    <div class="message is-info">
      <div class="message-body">
        If you have recently submitted an application to make a change to the voter's list,
        you can check the status of your application here.
        Please enter your last name and confirmation code below.
      </div>
    </div>

    <div class="columns">
      <div class="column">
        <div class="control">
          <label class="label" for="status--lastName">Last Name</label>
          <input
            class="input"
            id="status--lastName"
            name="lastName"
            type="text"
            maxlength="40"
            required
          />
        </div>
      </div>
      <div class="column">
        <div class="control">
          <label class="label" for="status--confirmationCode">Confirmation Code</label>
          <input
            class="input is-uppercase"
            id="status--confirmationCode"
            name="confirmationCode"
            type="text"
            minlength="8"
            maxlength="8"
            autocapitalize="characters"
            required
          />
        </div>
      </div>
    </div>
    <p class="has-text-centered">
      <button class="button is-medium is-success" type="submit">
        <span class="icon">
          <i class="fa-solid fa-circle-info"></i>
        </span>
        <span>Check Voter's List Application Status</span>
      </button>
    </p>
  </form>
</div>

<%- include('_votersListFooter.ejs', { scriptName: 'votersListCheck' }) -%>
