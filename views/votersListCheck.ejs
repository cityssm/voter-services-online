<%- include('_votersListHeader.ejs') -%>

<form action="<%= urlPrefix %>/votersList/result" method="POST">
  <div class="columns">
    <div class="column">
      <div class="field">
        <label class="label" for="votersList--firstName">
          First Name
        </label>
        <div class="control">
          <input
            class="input"
            id="votersList--firstName"
            name="firstName"
            type="text"
            maxlength="40"
            autofocus
            required
          />
        </div>
      </div>
    </div>
    <div class="column">
      <div class="field">
        <label class="label" for="votersList--lastName">
          Last Name
        </label>
        <div class="control">
          <input
            class="input"
            id="votersList--lastName"
            name="lastName"
            type="text"
            maxlength="40"
            required
          />
        </div>
      </div>
    </div>
  </div>

  <fieldset class="mb-4">
    <legend class="label">Date of Birth</legend>

    <div class="field has-addons">
      <div class="control is-expanded">
        <input
          class="input"
          id="votersList--dateOfBirthYear"
          name="dateOfBirthYear"
          type="number"
          min="<%= new Date().getFullYear() - 120 %>"
          max="<%= new Date().getFullYear() %>"
          aria-label="Date of Birth Year"
          placeholder="Year"
          required
        />
      </div>
      <div class="control">
        <span class="button is-static">-</span>
      </div>
      <div class="control is-expanded">
        <div class="select is-fullwidth">
          <select
            id="votersList--dateOfBirthMonth"
            name="dateOfBirthMonth"
            aria-label="Date of Birth Month"
            required
          >
            <option value="">(Select a Month)</option>
            <option value="01">January</option>
            <option value="02">February</option>
            <option value="03">March</option>
            <option value="04">April</option>
            <option value="05">May</option>
            <option value="06">June</option>
            <option value="07">July</option>
            <option value="08">August</option>
            <option value="09">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
          </select>
        </div>
      </div>
      <div class="control">
        <span class="button is-static">-</span>
      </div>
      <div class="control is-expanded">
        <input
          class="input"
          id="votersList--dateOfBirthDay"
          name="dateOfBirthDay"
          type="number"
          min="1"
          max="31"
          aria-label="Date of Birth Day"
          placeholder="Day"
          required
        />
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend class="title is-5">Residential Address</legend>

    <div class="columns">
      <div class="column is-3">
        <div class="field">
          <label class="label" for="votersList--streetNumber">
            Street Number
          </label>
          <div class="control">
            <input
              class="input"
              id="votersList--streetNumber"
              name="streetNumber"
              type="text"
              maxlength="5"
              pattern="^[0-9]+.+"
              required
            />
          </div>
        </div>
      </div>
      <div class="column is-6">
        <div class="field">
          <label class="label" for="votersList--streetName">
            Street Name
          </label>
          <div class="control is-expanded">
            <div class="select is-fullwidth">
              <select
                id="votersList--streetName"
                name="streetName"
                aria-label="Street Name"
                required
              >
                <option value="">(Loading street names...)</option>
              </select>
            </div>
          </div>
        </div>
      </div>
      <div class="column">
        <div class="field">
          <label class="label" for="votersList--unitNumber">
            Unit
          </label>
          <div class="control">
            <input
              class="input"
              id="votersList--unitNumber"
              name="unitNumber"
              type="text"
              maxlength="10"
            />
          </div>
        </div>
      </div>
    </div>
  </fieldset>

  <p class="has-text-right mt-5">
    <button class="button is-success" id="votersList--submit" type="submit">
      <span class="icon">
        <i class="fa-solid fa-check-to-slot"></i>
      </span>
      <span>Lookup Voter's List Record</span>
    </button>
  </p>
</form>

<%- include('_votersListFooter.ejs', { scriptName: 'votersListCheck' }) -%>
