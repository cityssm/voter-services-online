<!doctype html>
<html data-theme="light" lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>
      <%= configFunctions.getConfigProperty('application.applicationName') %>
    </title>

    <link href="<%= urlPrefix %>/lib/bulma/bulma.min.css" rel="stylesheet" />
    <link href="<%= urlPrefix %>/stylesheets/style.css" rel="stylesheet" />
  </head>

  <body data-url-prefix="<%= urlPrefix %>">
    <nav class="level has-background-dark p-4" role="navigation" aria-label="main navigation">
      <div class="level-left">
        <div class="level-item has-text-white has-text-weight-bold is-size-4">
          <%= configFunctions.getConfigProperty("application.applicationName") %>
        </div>
        <% if (configFunctions.getConfigProperty("voterViewApi.useTrainingDatabase")) { %>
        <div class="level-item">
          <div class="tag is-warning">
            <span class="icon">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </span>
            <span>Training Database</span>
          </div>
        </div>
        <% } %>
      </div>
      <div class="level-right">
        <div class="level-item">
          <div class="buttons is-justify-content-center">
            <button class="button is-medium is-success" id="button--votersList" type="button">
              <span class="icon">
                <i class="fa-solid fa-check-to-slot"></i>
              </span>
              <span>Voter's List Inquiry</span>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <div class="px-4">
      <main class="columns is-multiline">
        <aside class="column is-4-desktop is-12-touch">
          <form class="mb-4" id="form--addressSearch">
            <label class="label" for="addressSearch--civicAddress">
              Civic Address
            </label>
            <div class="field has-addons">
              <div class="control is-expanded has-icons-left">
                <input
                  class="input"
                  id="addressSearch--civicAddress"
                  name="civicAddress"
                  type="text"
                  placeholder="123 Main St."
                />
                <span class="icon is-small is-left">
                  <i class="fas fa-search"></i>
                </span>
              </div>
              <div class="control">
                <button class="button" type="reset" title="Clear">
                  <span class="icon">
                    <i class="fas fa-times"></i>
                  </span>
                </button>
              </div>
            </div>
          </form>
          <div id="container--addressSearchResults"></div>
        </aside>
        <section class="column">
          <div class="is-hidden" id="container--addressDetails">
            <div class="columns is-mobile is-vcentered">
              <div class="column">
                <h1 class="title is-4" id="addressDetails--address">Address Details</h1>
              </div>
              <div class="column is-narrow has-text-right">
                <div class="field is-grouped is-grouped-multiline">
                  <div class="control">
                    <div class="tags has-addons">
                      <span class="tag is-dark">Ward</span>
                      <span class="tag" id="addressDetails--ward">N/A</span>
                    </div>
                  </div>
                  <div class="control">
                    <div class="tags has-addons">
                      <span class="tag is-dark">Poll</span>
                      <span class="tag" id="addressDetails--pollAndSuffix">N/A</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="columns">
              <div class="column">
                <h2 class="title is-5">Voting Locations</h2>
                <div id="container--votingLocations"></div>
              </div>
              <div class="column">
                <h2 class="title is-5">Candidates</h2>
                <div id="container--candidates"></div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="modal" id="modal--votersList">
      <div class="modal-background"></div>
      <div class="modal-card" style="width:900px;max-width:100%;">
        <header class="modal-card-head">
          <p class="modal-card-title">Voter's List Inquiry</p>
          <button class="delete modal-close-button" type="button" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
          <iframe
            id="iframe--votersList"
            src=""
            title="Voter's List Inquiry"
            style="border: none"
            height="600"
            width="100%"
          ></iframe>
        </section>
        <footer class="modal-card-foot is-justify-content-flex-end">
          <button class="button modal-close-button" type="button">Close</button>
        </footer>
      </div>
    </div>
    
    <script src="<%= urlPrefix %>/javascripts/all.js"></script>
    <script src="<%= urlPrefix %>/javascripts/main.js"></script>
    <script src="<%= urlPrefix %>/lib/fa/js/all.min.js" defer></script>
  </body>
</html>
